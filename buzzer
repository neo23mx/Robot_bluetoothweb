# --------------------------------
# VARIABLES DE LA MELODIA
# --------------------------------

_melodia_actual = None
_posicion = 0
_inicio_nota = 0


# --------------------------------
# GENERAR SONIDO
# --------------------------------

def _sonar(frecuencia):

    if frecuencia == 0:
        _buzzer.duty_u16(0)

    else:
        _buzzer.freq(frecuencia)
        _buzzer.duty_u16(32768)


# --------------------------------
# TOCAR NOTA INDIVIDUAL
# --------------------------------

def tocar(frecuencia):

    global _melodia_actual

    _melodia_actual = None
    _sonar(frecuencia)


# --------------------------------
# APAGAR
# --------------------------------

def apagar():

    global _melodia_actual

    _melodia_actual = None
    _buzzer.duty_u16(0)


# --------------------------------
# INICIAR MELODIA
# --------------------------------

def melodia(cancion):

    global _melodia_actual
    global _posicion
    global _inicio_nota

    _melodia_actual = cancion
    _posicion = 0

    frecuencia, duracion = _melodia_actual[0]

    _sonar(frecuencia)

    _inicio_nota = time.ticks_ms()


# --------------------------------
# ACTUALIZAR MELODIA
# --------------------------------

